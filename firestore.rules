rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Admin = account base.basement.workspace@gmail.com con email verificata
    // (la verifica dimostra che chi entra controlla davvero quella casella Gmail).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'base.basement.workspace@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validName(value) { return value is string && value.size() > 0 && value.size() <= 60; }
    function validPhone(value) { return value is string && value.matches('^\\+?[0-9]{8,15}$'); }
    function validIdNumber(value) { return value is string && value.matches('^[A-Z0-9]{5,20}$'); }

    function profilePath(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function profileActive(uid) {
      return exists(profilePath(uid)) && get(profilePath(uid)).data.get('blocked', false) != true;
    }
    function eventOpen(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return event.status == 'published' && event.endAt > request.time;
    }

    // Dati personali: li leggono solo il membro stesso e l'admin.
    match /profiles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'firstName', 'lastName', 'fullName', 'email', 'phone', 'idNumber', 'adult', 'privacyVersion', 'privacyAcceptedAt', 'marketing', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.firstName)
        && validName(request.resource.data.lastName)
        && validPhone(request.resource.data.phone)
        && validIdNumber(request.resource.data.idNumber)
        && request.resource.data.adult == true
        && request.resource.data.privacyVersion is string
        && request.resource.data.privacyAcceptedAt == request.time
        && request.resource.data.marketing is bool
        && request.resource.data.createdAt == request.time;
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'fullName', 'phone', 'idNumber', 'marketing', 'updatedAt'])
          && validName(request.resource.data.firstName)
          && validName(request.resource.data.lastName)
          && validPhone(request.resource.data.phone)
          && validIdNumber(request.resource.data.idNumber)
          && request.resource.data.marketing is bool)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'blockedAt']));
      // Diritto alla cancellazione: il membro può eliminare il proprio profilo.
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Eventi: pubblici solo se pubblicati, scrivibili solo dall'admin.
    match /events/{eventId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow write: if isAdmin();
    }

    // Locandine (JPEG compresso in base64), separate dagli eventi per non appesantire le liste.
    match /posters/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Un ticket per coppia evento/membro: id = <eventId>_<uid>.
    // Il membro lo crea una sola volta (stato 'issued'); solo l'admin lo convalida.
    match /tickets/{ticketId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'code', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && ticketId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.status == 'issued'
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{24}$')
        && request.resource.data.createdAt == request.time
        && profileActive(request.auth.uid)
        && eventOpen(request.resource.data.eventId);
      allow update: if isAdmin();
      // Il membro può cancellare i propri ticket solo dopo aver eliminato il profilo
      // (così non può "resettare" un QR già usato per rientrare).
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && !exists(profilePath(request.auth.uid)));
    }
  }
}
